; DIGIHARIMAN — ORANGE PROTOCOL
; Godot 4.4 / Forward+ / target hardware: Windows 11, 64 GB RAM, RTX 5080

config_version=5

[application]

config/name="DIGIHARIMAN - ORANGE PROTOCOL"
config/description="デジハリマンが活躍するAAA品質の3Dアクションゲーム。"
config/version="1.0.0"
run/main_scene="res://scenes/Main.tscn"
config/features=PackedStringArray("4.4", "Forward Plus")
config/icon="res://icon.svg"
boot_splash/bg_color=Color(0.035, 0.03, 0.028, 1)
boot_splash/show_image=false

[autoload]

Signals="*res://src/core/signals.gd"
Settings="*res://src/core/settings.gd"
Quality="*res://src/core/quality.gd"
Game="*res://src/core/game.gd"
Audio="*res://src/audio/audio_director.gd"

[display]

window/size/viewport_width=2560
window/size/viewport_height=1440
window/size/mode=3
window/stretch/mode="viewport"
window/stretch/aspect="expand"
window/vsync/vsync_mode=0

[editor_plugins]

enabled=PackedStringArray("res://addons/polyhaven_bridge/plugin.cfg")

[filesystem]

import/blender/enabled=false

