[layer_names]

3d_physics/layer_1="world"
3d_physics/layer_2="player"
3d_physics/layer_3="enemy"
3d_physics/layer_4="player_hitbox"
3d_physics/layer_5="enemy_hitbox"
3d_physics/layer_6="props"
3d_render/layer_1="default"
3d_render/layer_2="character"
3d_render/layer_3="foliage"

[physics]

3d/default_gravity=22.0
common/physics_ticks_per_second=60
common/max_physics_steps_per_frame=16

[rendering]

renderer/rendering_method="forward_plus"
textures/default_filters/anisotropic_filtering_level=4
textures/default_filters/use_nearest_mipmap_filter=false
lights_and_shadows/directional_shadow/size=8192
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=4
lights_and_shadows/positional_shadow/atlas_size=4096
lights_and_shadows/positional_shadow/soft_shadow_filter_quality=4
lights_and_shadows/positional_shadow/atlas_16_bits=false
global_illumination/gi/use_half_resolution=false
global_illumination/sdfgi/probe_ray_count=3
global_illumination/sdfgi/frames_to_converge=4
global_illumination/sdfgi/frames_to_update_lights=2
global_illumination/voxel_gi/quality=1
environment/ssao/quality=4
environment/ssao/half_size=true
environment/ssil/quality=4
environment/ssil/half_size=true
environment/screen_space_reflection/roughness_quality=3
environment/subsurface_scattering/subsurface_scattering_quality=3
environment/subsurface_scattering/subsurface_scattering_scale=0.6
environment/volumetric_fog/volume_size=128
environment/volumetric_fog/volume_depth=192
environment/volumetric_fog/use_filter=1
anti_aliasing/quality/msaa_3d=0
anti_aliasing/quality/screen_space_aa=0
anti_aliasing/quality/use_taa=true
anti_aliasing/quality/use_debanding=true
scaling_3d/mode=0
scaling_3d/scale=1.0
occlusion_culling/use_occlusion_culling=true
limits/opengl/max_lights_per_object=16
camera/depth_of_field/depth_of_field_bokeh_shape=2
camera/depth_of_field/depth_of_field_bokeh_quality=3
camera/depth_of_field/depth_of_field_use_jitter=true
